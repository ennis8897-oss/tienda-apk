rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() { return request.auth != null && request.auth.uid == 'REEMPLAZAR_CON_TU_UID'; }
    match /apps/{appId} {
      allow get, list: if admin() || resource.data.published == true;
      allow create, update, delete: if admin();
    }
  }
}
