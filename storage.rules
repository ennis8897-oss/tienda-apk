rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /apks/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'REEMPLAZAR_CON_TU_UID' && uid == request.auth.uid && request.resource.size < 50 * 1024 * 1024 && request.resource.contentType == 'application/vnd.android.package-archive';
      allow delete: if request.auth != null && request.auth.uid == 'REEMPLAZAR_CON_TU_UID' && uid == request.auth.uid;
    }
  }
}
